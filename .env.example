# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. When unset it falls back to Vercel's production
# domain (VERCEL_PROJECT_PRODUCTION_URL — a Vercel system variable, set by
# Vercel at build time, never by hand), then to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Resend API key (https://resend.com) — delivers contact form messages directly to your inbox.
RESEND_API_KEY=

# The inbox where contact form notifications will be delivered.
# In Resend's free tier without domain verification, this must match your Resend account email.
CONTACT_NOTIFICATION_EMAIL=sardar22balti@gmail.com

# Optional custom sender address once you verify a domain at resend.com/domains (e.g. contact@sardarhussain.me)
# RESEND_FROM_EMAIL=Portfolio <contact@sardarhussain.me>

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
CONTACT_ENDPOINT=
